{% extends 'layout/base.twig' %}
{% block title %}{{ t('orders.title') }} · {{ parent() }}{% endblock %}
{% block content %}
  <section class="container-page py-8 space-y-6">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <h1 class="h1">{{ t('orders.title') }}</h1>
      <a href="/account" class="link text-sm">{{ t('nav.account') }}</a>
    </div>
    {% if orders is empty %}
      <div class="card text-center py-10 space-y-3"><p>{{ t('orders.none') }}</p><a href="/catalogo" class="btn btn-primary">{{ t('nav.catalog') }}</a></div>
    {% else %}
      <div class="table-wrap">
        <table class="table">
          <thead><tr><th>{{ t('orders.order') }}</th><th>{{ t('orders.date') }}</th><th class="num">{{ t('cart.pairs') }}</th><th class="num">{{ t('cart.total') }}</th><th>{{ t('orders.state') }}</th></tr></thead>
          <tbody>
            {% for o in orders %}
              <tr class="row-link" data-href="/account/ordini/{{ o.id }}">
                <td><a href="/account/ordini/{{ o.id }}" class="font-semibold">#{{ o.id }}</a></td>
                <td>{{ o.created_at|local_date }}</td>
                <td class="num">{{ o.pairs }}</td>
                <td class="num">{{ money(o.total_cents) }}</td>
                <td>{% include 'account/_status.twig' with {status: o.status} %}</td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    {% endif %}
  </section>
{% endblock %}
