<article class="product-card {{ p.sold_out ? 'is-sold-out' }}">
  <a href="{{ base_path }}/prodotto/{{ p.sku|url_encode }}" class="product-card-media" data-quickview tabindex="-1" aria-hidden="true">
    {% if p.image %}<img src="{{ p.image }}" alt="{{ p.name }}" loading="lazy" width="400" height="300">{% else %}<span class="product-card-noimg"></span>{% endif %}
  </a>
  <div class="product-card-body">
    <div class="flex flex-wrap items-center gap-1.5">
      <span class="pill pill-{{ p.availability }}">{{ t('catalog.availability_level.' ~ p.availability) }}</span>
      {% if p.has_immediate %}<span class="badge badge-ok">{{ t('catalog.immediate_badge') }}</span>{% endif %}
      {% if p.featured %}<span class="badge badge-ink">{{ t('catalog.featured_badge') }}</span>{% endif %}
    </div>
    <p class="text-xs text-muted uppercase tracking-wide">{{ p.brand }}</p>
    <h2 class="product-card-title"><a href="{{ base_path }}/prodotto/{{ p.sku|url_encode }}" data-quickview>{{ p.name }}</a></h2>
    <p class="text-xs text-muted">SKU <span class="copyable"><code>{{ p.sku }}</code><button type="button" class="btn btn-xs btn-ghost" data-copy="{{ p.sku }}" data-copied-label="{{ t('common.copied') }}">{{ t('common.copy') }}</button></span></p>
    {% if p.sizes is not empty %}
      <ul class="size-chips" aria-label="{{ t('catalog.sizes_available') }}">
        {% for s in p.sizes|slice(0, 10) %}<li>{{ s.label }}</li>{% endfor %}
        {% if p.sizes|length > 10 %}<li class="more">+{{ p.sizes|length - 10 }}</li>{% endif %}
      </ul>
    {% endif %}
    <div class="product-card-footer">
      {% if p.sold_out %}
        <p class="font-semibold text-muted">{{ t('catalog.sold_out') }}</p>
      {% elseif show_prices and p.price_from is not null %}
        <p><span class="text-sm text-muted">{{ t('catalog.price_from') }}</span> <span class="price">{{ money(p.price_from) }}</span>
          <span class="block text-xs text-muted">{{ t('catalog.regime_label.' ~ p.price_regime) }}</span></p>
      {% else %}
        <p class="text-sm font-semibold">{{ t('catalog.reserved') }}</p>
      {% endif %}
      {% if not p.sold_out %}
        <a href="{{ base_path }}/prodotto/{{ p.sku|url_encode }}" class="btn btn-primary btn-sm" data-quickview>{{ show_prices ? t('catalog.choose_sizes') : t('catalog.details') }}</a>
      {% endif %}
    </div>
  </div>
</article>
