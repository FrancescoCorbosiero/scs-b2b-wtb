{# Riepilogo dell'ordine per le email al cliente: SOLO dati di OrderPresenter. #}
{% for block in [{key: 'margin', lines: order.lines_margin}, {key: 'ordinary', lines: order.lines_ordinary}] %}
  {% if block.lines is not empty %}
    <p style="margin:16px 0 6px;font-weight:bold;">{{ t('orders.block_' ~ block.key) }}</p>
    <table role="presentation" width="100%" cellpadding="6" cellspacing="0" style="border-collapse:collapse;font-size:13px;">
      {% for l in block.lines %}
        <tr style="border-bottom:1px solid #e4dfd6;">
          <td>{{ l.name }}<br><span style="color:#6b665e;">SKU {{ l.sku }} · EU {{ l.size_eu }}</span></td>
          <td style="white-space:nowrap;">
            {% if l.qty_immediate > 0 %}{{ l.qty_immediate }} × {{ money(l.unit_price_immediate_cents) }}<br>{% endif %}
            {% if l.qty_extended > 0 %}{{ l.qty_extended }} × {{ money(l.unit_price_extended_cents) }} ({{ t('product.extended')|lower }}){% endif %}
          </td>
          <td align="right" style="white-space:nowrap;">{{ money(l.line_total_cents) }}</td>
        </tr>
      {% endfor %}
    </table>
  {% endif %}
{% endfor %}
<table role="presentation" width="100%" cellpadding="4" cellspacing="0" style="font-size:14px;margin-top:10px;">
  {% if order.subtotal_margin_cents > 0 %}<tr><td>{{ t('cart.subtotal_margin') }}</td><td align="right">{{ money(order.subtotal_margin_cents) }}</td></tr>{% endif %}
  {% if order.subtotal_ordinary_cents > 0 %}<tr><td>{{ t('cart.subtotal_ordinary') }}</td><td align="right">{{ money(order.subtotal_ordinary_cents) }}</td></tr>{% endif %}
  <tr><td>{{ t('orders.shipping') }}</td><td align="right">{{ order.shipping_cents == 0 ? t('cart.free') : money(order.shipping_cents) }}</td></tr>
  <tr><td>{{ order.vat_rate_bp > 0 ? t('cart.vat_rate', {rate: order.vat_rate_bp // 100}) : t('cart.vat') }}</td><td align="right">{{ money(order.vat_cents) }}</td></tr>
  <tr><td style="font-weight:bold;">{{ t('orders.total') }}</td><td align="right" style="font-weight:bold;">{{ money(order.total_cents) }}</td></tr>
</table>
{% for legend in order.legends %}<p style="font-size:12px;color:#6b665e;margin:4px 0;">{{ t(legend) }}</p>{% endfor %}
