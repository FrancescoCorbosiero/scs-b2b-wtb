{#- Email: blocchi "subject", "html" e "text" resi separatamente dal Mailer. Stili inline: servono ai client di posta. -#}
{% block subject %}{% endblock %}
{% block html %}
<!doctype html>
<html lang="{{ email_locale }}">
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width"><title>{{ block('subject') }}</title></head>
<body style="margin:0;padding:0;background:#f5f2ec;font-family:Arial,Helvetica,sans-serif;color:#111111;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f5f2ec;">
    <tr><td align="center" style="padding:24px 12px;">
      <table role="presentation" width="600" cellpadding="0" cellspacing="0" style="max-width:600px;width:100%;background:#ffffff;border:1px solid #e4dfd6;">
        <tr><td style="background:#111111;color:#f5f2ec;padding:18px 24px;font-size:18px;font-weight:bold;letter-spacing:0.02em;">{{ setting('company.site_name') }}</td></tr>
        <tr><td style="padding:24px;font-size:15px;line-height:1.55;">
          {% block body %}{% endblock %}
          <p style="margin:24px 0 0;">{{ t('emails.signature', {site: setting('company.site_name')}) }}</p>
        </td></tr>
        <tr><td style="padding:16px 24px;border-top:1px solid #e4dfd6;font-size:12px;color:#6b665e;">
          {{ setting('company.name') }} · {{ setting('company.address') }} · {{ setting('company.email') }}<br>
          {% block footer_note %}{{ t('emails.footer', {site: setting('company.site_name')}) }}{% endblock %}
        </td></tr>
      </table>
    </td></tr>
  </table>
</body>
</html>
{% endblock %}
{% block text %}{% endblock %}
