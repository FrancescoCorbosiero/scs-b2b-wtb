{% extends 'emails/layout.twig' %}
{% block subject %}{{ t('emails.reset.subject', {site: setting('company.site_name')}) }}{% endblock %}
{% block body %}
  <p>{{ t('emails.greeting', {name: user.name}) }}</p>
  <p>{{ t('emails.reset.intro') }}</p>
  <p>{{ t('emails.reset.action', {hours: hours}) }}</p>
  {% include 'emails/_button.twig' with {href: link, label: t('emails.reset.button')} only %}
{% endblock %}
{% block text %}
{{ t('emails.greeting', {name: user.name}) }}

{{ t('emails.reset.intro') }}
{{ t('emails.reset.action', {hours: hours}) }}

{{ link }}

{{ t('emails.signature', {site: setting('company.site_name')}) }}
{% endblock %}
