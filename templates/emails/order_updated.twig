{% extends 'emails/layout.twig' %}
{% block subject %}{{ t('emails.order_updated.subject', {id: order.id, site: setting('company.site_name')}) }}{% endblock %}
{% block body %}
  <p>{{ t('emails.greeting', {name: order.contact_name}) }}</p>
  <p>{{ t('emails.order_updated.intro', {id: order.id}) }}</p>
  {% include 'emails/_order_table.twig' %}
  {% if order.status == 'pending' %}{% include 'emails/_bank.twig' %}{% else %}<p>{{ t('emails.order_updated.refund') }}</p>{% endif %}
  {% include 'emails/_button.twig' with {href: link, label: t('emails.order_received.button')} only %}
{% endblock %}
{% block text %}
{{ t('emails.greeting', {name: order.contact_name}) }}

{{ t('emails.order_updated.intro', {id: order.id}) }}
{{ t('orders.total') }}: {{ money(order.total_cents) }}
{% if order.status == 'pending' %}IBAN: {{ bank.iban }} · {{ t('orders.reason') }}: {{ t('orders.reference', {id: order.id}) }}{% else %}{{ t('emails.order_updated.refund') }}{% endif %}

{{ link }}
{% endblock %}
