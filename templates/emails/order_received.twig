{% extends 'emails/layout.twig' %}
{% block subject %}{{ t('emails.order_received.subject', {id: order.id, site: setting('company.site_name')}) }}{% endblock %}
{% block body %}
  <p>{{ t('emails.greeting', {name: order.contact_name}) }}</p>
  <p>{{ t('emails.order_received.intro', {id: order.id}) }}</p>
  {% include 'emails/_bank.twig' %}
  <p>{{ t('emails.order_received.confirm_on_payment') }}</p>
  {% include 'emails/_order_table.twig' %}
  {% if order.delivery_days %}<p style="font-size:13px;">{{ t('emails.order_received.delivery', {days: order.delivery_days}) }}</p>{% endif %}
  {% include 'emails/_button.twig' with {href: link, label: t('emails.order_received.button')} only %}
{% endblock %}
{% block text %}
{{ t('emails.greeting', {name: order.contact_name}) }}

{{ t('emails.order_received.intro', {id: order.id}) }}

{{ t('orders.bank_title') }}
{{ t('bank.holder') }}: {{ bank.holder }}
IBAN: {{ bank.iban }}
{% if bank.bic %}BIC/SWIFT: {{ bank.bic }}
{% endif %}{{ t('orders.amount') }}: {{ money(order.total_cents) }}
{{ t('orders.reason') }}: {{ t('orders.reference', {id: order.id}) }}

{{ t('emails.order_received.confirm_on_payment') }}

{% for l in order.lines_margin|merge(order.lines_ordinary) %}- {{ l.name }} · EU {{ l.size_eu }} · {{ l.qty_immediate + l.qty_extended }} · {{ money(l.line_total_cents) }}
{% endfor %}
{{ t('orders.total') }}: {{ money(order.total_cents) }}

{{ link }}
{% endblock %}
