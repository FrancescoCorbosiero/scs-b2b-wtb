{% extends 'emails/layout.twig' %}
{% block subject %}{{ t('emails.order_confirmed.subject', {id: order.id, site: setting('company.site_name')}) }}{% endblock %}
{% block body %}
  <p>{{ t('emails.greeting', {name: order.contact_name}) }}</p>
  <p>{{ t('emails.order_confirmed.intro', {id: order.id}) }}</p>
  <p>{{ t('emails.order_confirmed.proforma', {number: order.receipt_number}) }}</p>
  <p>{{ t('emails.order_confirmed.next') }}</p>
  {% include 'emails/_order_table.twig' %}
  {% include 'emails/_button.twig' with {href: link, label: t('emails.order_received.button')} only %}
{% endblock %}
{% block text %}
{{ t('emails.greeting', {name: order.contact_name}) }}

{{ t('emails.order_confirmed.intro', {id: order.id}) }}
{{ t('emails.order_confirmed.proforma', {number: order.receipt_number}) }}
{{ t('emails.order_confirmed.next') }}

{{ t('orders.total') }}: {{ money(order.total_cents) }}
{{ link }}
{% endblock %}
