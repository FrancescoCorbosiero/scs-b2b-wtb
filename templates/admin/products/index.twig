{% extends 'admin/layout.twig' %}
{% block title %}{{ t('admin.products.title') }}{% endblock %}
{% block content %}
  <div class="flex flex-wrap items-end justify-between gap-4 mb-6">
    <h1 class="h1">{{ t('admin.products.title') }}</h1>
    <p class="text-sm text-muted">{{ t('admin.products.intro') }}</p>
  </div>
  <form method="get" action="/admin/prodotti" class="flex flex-wrap gap-2 mb-4">
    <input class="input w-72" type="search" name="q" value="{{ q }}" placeholder="{{ t('catalog.search_placeholder') }}">
    <label class="check"><input type="checkbox" name="evidenza" value="1" {{ featured ? 'checked' }}> {{ t('catalog.featured_only') }}</label>
    <button class="btn btn-ghost" type="submit">{{ t('common.search') }}</button>
  </form>
  <div class="table-wrap">
    <table class="table">
      <thead><tr><th>SKU</th><th>{{ t('export.name') }}</th><th class="num">{{ t('admin.products.available') }}</th><th class="num">{{ t('admin.products.price_from') }}</th><th>{{ t('admin.products.state') }}</th><th>{{ t('catalog.featured_badge') }}</th></tr></thead>
      <tbody>
        {% for p in products %}
          <tr class="row-link" data-href="/admin/prodotti/{{ p.id }}">
            <td><code class="text-xs">{{ p.sku }}</code></td>
            <td><a href="/admin/prodotti/{{ p.id }}" class="font-semibold">{{ p.name }}</a><br><span class="text-xs text-muted">{{ p.brand }}{% if p.line %} · {{ p.line }}{% endif %}</span></td>
            <td class="num">{{ p.total_available }}</td>
            <td class="num">{{ p.min_price_cents is null ? '—' : money(p.min_price_cents) }}</td>
            <td>
              {% if not p.is_active %}<span class="badge badge-muted">{{ t('admin.products.inactive') }}</span>
              {% elseif not p.in_feed %}<span class="badge badge-warn">{{ t('admin.products.out_of_feed') }}</span>
              {% elseif p.total_available == 0 %}<span class="badge badge-muted">{{ t('catalog.sold_out') }}</span>
              {% else %}<span class="badge badge-ok">{{ t('admin.products.on_sale') }}</span>{% endif %}
            </td>
            <td>
              <form method="post" action="/admin/prodotti/{{ p.id }}/evidenza">{{ csrf_field() }}<input type="hidden" hidden name="back" value="/admin/prodotti{{ q ? '?q=' ~ q|url_encode }}">
                <button class="btn btn-xs {{ p.is_featured ? 'btn-primary' : 'btn-ghost' }}" type="submit">{{ p.is_featured ? '★' : '☆' }}</button></form>
            </td>
          </tr>
        {% else %}
          <tr><td colspan="6" class="text-muted">{{ t('admin.products.empty') }}</td></tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
{% endblock %}
