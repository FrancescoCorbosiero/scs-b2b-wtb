{% extends 'admin/layout_bare.twig' %}
{% block title %}{{ t('admin.login.title') }}{% endblock %}
{% block content %}
  <section class="container-narrow py-12">
    <form method="post" action="/admin/login" class="card space-y-4">
      {{ csrf_field() }}
      <h1 class="h2">{{ t('admin.login.title') }}</h1>
      {% if not configured %}<div class="alert alert-warning">{{ t('admin.login.not_configured') }}</div>{% endif %}
      <div class="field">
        <label class="label" for="f-name">{{ t('admin.login.name') }} <span class="text-muted">({{ t('common.optional') }})</span></label>
        <input class="input" id="f-name" name="name" maxlength="60" value="{{ old('name') }}" autocomplete="nickname">
        <p class="hint">{{ t('admin.login.name_hint') }}</p>
      </div>
      <div class="field">
        <label class="label" for="f-password">{{ t('auth.password') }}</label>
        <input class="input" id="f-password" name="password" type="password" required autofocus autocomplete="current-password">
      </div>
      <button type="submit" class="btn btn-primary w-full">{{ t('auth.submit_login') }}</button>
    </form>
  </section>
{% endblock %}
