{% extends 'admin/layout.twig' %}
{% import 'admin/macros.twig' as m %}
{% block title %}{{ t('admin.dashboard.title') }}{% endblock %}
{% block content %}
  <h1 class="h1 mb-6">{{ t('admin.dashboard.title') }}</h1>
  {% if alerts is not empty %}
    <section class="space-y-2 mb-8" aria-label="{{ t('admin.dashboard.alerts') }}">
      {% for a in alerts %}
        <a href="{{ a.href }}" class="alert {{ a.level == 'error' ? 'alert-error' : 'alert-warning' }} block">
          <strong>{{ a.title }}</strong> — {{ a.text }}
        </a>
      {% endfor %}
    </section>
  {% else %}
    <p class="alert alert-success mb-8">{{ t('admin.dashboard.no_alerts') }}</p>
  {% endif %}
  <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
    {% for card in cards %}
      <a href="{{ card.href }}" class="card card-link">
        <p class="text-sm text-muted">{{ card.label }}</p>
        <p class="text-3xl font-bold tabular-nums">{{ card.value }}</p>
        {% if card.note ?? false %}<p class="text-xs text-muted mt-1">{{ card.note }}</p>{% endif %}
      </a>
    {% endfor %}
  </div>

  <section class="mt-10" id="da-pagare" aria-labelledby="to-pay-title">
    <h2 class="h2 mb-2" id="to-pay-title">{{ t('admin.dashboard.to_pay_title') }}</h2>
    <p class="text-sm text-muted mb-4">{{ t('admin.dashboard.to_pay_text') }}</p>
    {% if to_pay is empty %}
      <p class="text-sm text-muted">{{ t('admin.dashboard.to_pay_none') }}</p>
    {% else %}
      <div class="table-wrap">
        <table class="table">
          <thead><tr><th>{{ t('admin.orders.order', {id: ''})|trim }}</th><th>{{ t('admin.supplier.reference') }}</th><th class="num">{{ t('admin.supplier.total') }}</th><th>{{ t('admin.supplier.instructions_title') }}</th></tr></thead>
          <tbody>
            {% for r in to_pay %}
              <tr>
                <td><a class="link font-semibold" href="/admin/ordini/{{ r.order_id }}#fornitore">{{ r.order_id }}</a><span class="block text-xs text-muted">{{ r.company }} · {{ r.created_at|local_datetime }}</span>{% if r.mode != 'live' %} <span class="badge badge-muted">{{ r.mode|upper }}</span>{% endif %}</td>
                <td><code>{{ r.reference }}</code>{% if r.wtb_number %}<span class="block text-xs text-muted">{{ r.wtb_number }}</span>{% endif %}</td>
                <td class="num">{{ r.total_cents is null ? '—' : money(r.total_cents) }}</td>
                <td class="text-sm">
                  {% for i in r.instructions|filter(i => i.highlight) %}
                    <span class="block">{{ t('admin.supplier.instructions.' ~ i.kind) }}: {{ m.copy(i.value) }}</span>
                  {% else %}
                    <span class="text-muted">{{ t('admin.supplier.no_instructions_short') }}</span>
                  {% endfor %}
                </td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    {% endif %}
  </section>
{% endblock %}
