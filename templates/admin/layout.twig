{# Area admin (solo italiano, D-012: qui il fornitore si può nominare). #}
<!doctype html>
<html lang="it">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% block title %}{{ t('admin.title') }}{% endblock %} · {{ t('admin.title') }}</title>
  <meta name="robots" content="noindex, nofollow">
  <link rel="stylesheet" href="{{ asset('app.css') }}">
  <script src="{{ asset('app.js') }}" defer></script>
</head>
<body class="min-h-screen bg-paper text-ink font-sans antialiased">
  {% include 'admin/_mode_banner.twig' %}
  <header class="admin-header">
    <div class="container-wide flex flex-wrap items-center justify-between gap-3 py-3">
      <a href="/admin" class="brand">{{ setting('company.site_name') }} <span class="text-paper/60 font-normal">· {{ t('admin.title') }}</span></a>
      <div class="flex items-center gap-3 text-sm">
        <span class="text-paper/70">{{ ctx.adminName }}</span>
        <form method="post" action="/admin/logout">{{ csrf_field() }}<button class="btn btn-sm btn-invert" type="submit">{{ t('admin.logout') }}</button></form>
      </div>
    </div>
    <nav class="container-wide admin-nav" aria-label="{{ t('admin.menu') }}">
      {% for item in admin_menu() %}
        <a href="{{ item.href }}" class="{{ (item.href == '/admin' ? ctx.path == '/admin' : path_is(item.href)) ? 'is-active' }}">{{ item.label }}{% if item.badge ?? 0 %} <span class="badge badge-warn">{{ item.badge }}</span>{% endif %}</a>
      {% endfor %}
    </nav>
  </header>
  <main id="main" class="container-wide py-6">
    {% include 'partials/flash.twig' %}
    {% block content %}{% endblock %}
  </main>
</body>
</html>
