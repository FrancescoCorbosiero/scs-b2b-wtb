{% extends 'layout/base.twig' %}
{% block title %}{{ t(purpose == 'reset' ? 'auth.set_title_reset' : 'auth.set_title_invite') }} · {{ parent() }}{% endblock %}
{% block content %}
  <section class="container-narrow py-12">
    <div class="card space-y-6">
      {% if valid %}
        <div class="space-y-2">
          <h1 class="h2">{{ t(purpose == 'reset' ? 'auth.set_title_reset' : 'auth.set_title_invite') }}</h1>
          <p class="text-muted">{{ t('auth.set_intro', {min: min_length}) }}</p>
        </div>
        <form method="post" action="/account/imposta-password" class="space-y-4">
          {{ csrf_field() }}
          <input type="hidden" hidden name="token" value="{{ token }}">
          <div class="field">
            <label class="label" for="f-password">{{ t('auth.password') }}</label>
            <input class="input" id="f-password" name="password" type="password" required minlength="{{ min_length }}" autocomplete="new-password">
          </div>
          <div class="field">
            <label class="label" for="f-password-confirm">{{ t('auth.password_confirm') }}</label>
            <input class="input" id="f-password-confirm" name="password_confirm" type="password" required minlength="{{ min_length }}" autocomplete="new-password">
          </div>
          <button type="submit" class="btn btn-primary w-full">{{ t('auth.set_submit') }}</button>
        </form>
      {% else %}
        <div class="space-y-2">
          <h1 class="h2">{{ t('auth.link_invalid_title') }}</h1>
          <p class="text-muted">{{ t('auth.link_invalid_text') }}</p>
        </div>
        <a href="/password-dimenticata" class="btn btn-primary">{{ t('auth.forgot_submit') }}</a>
      {% endif %}
    </div>
  </section>
{% endblock %}
