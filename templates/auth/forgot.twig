{% extends 'layout/base.twig' %}
{% import 'partials/forms.twig' as f %}
{% block title %}{{ t('auth.forgot_title') }} · {{ parent() }}{% endblock %}
{% block content %}
  <section class="container-narrow py-12">
    <div class="card space-y-6">
      <div class="space-y-2">
        <h1 class="h2">{{ t('auth.forgot_title') }}</h1>
        <p class="text-muted">{{ t('auth.forgot_intro') }}</p>
      </div>
      <form method="post" action="/password-dimenticata" class="space-y-4">
        {{ csrf_field() }}
        {{ f.input('email', t('auth.email'), '', 'email', {required: true, autocomplete: 'email'}) }}
        <button type="submit" class="btn btn-primary w-full">{{ t('auth.forgot_submit') }}</button>
      </form>
      <p class="text-sm"><a href="/login" class="link">{{ t('nav.login') }}</a></p>
    </div>
  </section>
{% endblock %}
