{% extends area == 'admin' ? 'admin/layout_bare.twig' : 'layout/base.twig' %}
{% block title %}{{ t('errors.' ~ kind ~ '_title') }}{% endblock %}
{% block content %}
  <section class="container-narrow py-16 text-center space-y-4">
    <p class="text-sm font-semibold text-muted">{{ status }}</p>
    <h1 class="h1">{{ t('errors.' ~ kind ~ '_title') }}</h1>
    <p class="text-muted">{{ t('errors.' ~ kind ~ '_text') }}</p>
    {% if details %}<pre class="text-left text-xs bg-ink text-paper p-4 overflow-x-auto rounded">{{ details }}</pre>{% endif %}
    <p><a href="{{ area == 'admin' ? '/admin' : '/' }}" class="btn btn-primary">{{ t('errors.go_home') }}</a></p>
  </section>
{% endblock %}
