{
    "name": "scs/b2b-wtb",
    "description": "Catalogo sneakers B2B ad accesso riservato per i rivenditori di SHOES & CLOTHING RESELLING.",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.3",
        "ext-curl": "*",
        "ext-intl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "ext-pdo_sqlite": "*",
        "dompdf/dompdf": "^3.0",
        "monolog/monolog": "^3.7",
        "openspout/openspout": "^4.28",
        "php-di/php-di": "^7.0",
        "phpmailer/phpmailer": "^6.9",
        "slim/psr7": "^1.7",
        "slim/slim": "^4.14",
        "slim/twig-view": "^3.4",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^11.4"
    },
    "suggest": {
        "ext-gd": "Miniature delle immagini prodotto (senza GD si servono gli originali)"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true,
        "platform": {
            "php": "8.3.6"
        }
    },
    "scripts": {
        "test": "phpunit",
        "stan": "phpstan analyse --memory-limit=1G --no-progress",
        "check": [
            "@test",
            "@stan"
        ]
    }
}
