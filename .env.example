# ---------------------------------------------------------------------------
# SCS B2B · WTB — variabili d'ambiente (D-021)
# Copia questo file in .env e adattalo. Il file .env non va MAI committato.
# Qui stanno solo server, segreti e modalità del fornitore: tutto ciò che il
# titolare regola (ordini al fornitore, margini, tariffe, catalogo…) è in
# Admin › Impostazioni. I valori qui sotto sono sicuri per lo sviluppo.
# ---------------------------------------------------------------------------

# --- Server -----------------------------------------------------------------
# development | production | test (sul server: production)
APP_ENV=development
# Indirizzo pubblico, senza barra finale (link nelle email)
APP_URL=http://127.0.0.1:8080
# Solo produzione: dominio per Caddy (D-018: ingrosso.shoesclothingstore.com)
APP_DOMAIN=
# Hash Argon2id della password admin: php bin/hash-password.php 'la-password' (tra apici singoli)
ADMIN_PASSWORD_HASH=
# Lato cliente (sito, vetrina, login, catalogo, carrello): 0 = spento, si usa solo l'admin (D-019); 1 = acceso
PUBLIC_SITE=0

# --- Email ------------------------------------------------------------------
# log = file .eml in var/mail/ (sviluppo) | smtp = invio vero (AWS SES in produzione)
MAIL_TRANSPORT=log
MAIL_FROM=no-reply@example.com
MAIL_FROM_NAME="SCS B2B"
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=

# --- Coordinate per i bonifici dei clienti (D-003) --------------------------
# Restano qui e non nell'admin: cambiare l'IBAN deve richiedere l'accesso al server (D-021)
BANK_HOLDER="SHOES & CLOTHING RESELLING OFFICIAL STORE"
BANK_NAME=
BANK_IBAN=
BANK_BIC=

# --- Fornitore (D-008, docs/03) ---------------------------------------------
# fixture = file in fixtures/wtb/, nessuna rete
# test    = API vera con la chiave di prova, ordini simulati dal fornitore
# live    = ordini veri con soldi veri: SOLO sul server di produzione
WTB_MODE=fixture
# Chiave di prova wtb_test_… In Claude Code web lasciala vuota: la aggiunge il proxy.
WTB_API_KEY_TEST=
# Chiave reale: SOLO nel .env del server di produzione, al momento del live
WTB_API_KEY_LIVE=
# Segreto dei webhook (whsec_…) dal portale del fornitore: serve solo in live (vuoto = nessun webhook valido).
# La simulazione dall'admin non lo chiede; bin/wtb-webhook.php --url sì (in sviluppo basta un valore inventato).
WTB_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Avanzate: facoltative. Senza la riga vale il default scritto qui; togli il #
# solo per cambiarlo. Normalmente non servono.
# ---------------------------------------------------------------------------
# APP_DEBUG=0                     # 1 = dettagli degli errori a video (solo con APP_ENV=development)
# APP_TIMEZONE=Europe/Rome        # fuso di date e orari mostrati (nel database tutto è in UTC)
# LOG_LEVEL=info                  # debug | info | warning | error (log in var/log/)
# DB_PATH=var/db.sqlite           # file SQLite (D-010), relativo alla radice o assoluto
# SESSION_LIFETIME=28800          # durata della sessione in secondi (8 ore)
# SESSION_SECURE=auto             # cookie solo HTTPS: auto | 1 | 0 (in produzione sempre 1)
# TRUSTED_PROXIES=                # CIDR da cui accettare X-Forwarded-*; in produzione vuoto: l'IP reale lo ricava nginx
# SMTP_PORT=587
# SMTP_ENCRYPTION=tls             # tls | ssl | none
# RECEIPT_PREFIX=PFW              # pro-forma <prefisso>-<anno>-<NNNN> (D-015)
# BACKUP_KEEP_DAYS=14             # giorni di backup giornalieri in var/backups/
# WTB_BASE_URL=https://b2b.wtbsnkrs.it/api/v1
# WTB_HTTP_TIMEOUT=20             # secondi per chiamata al fornitore
# WTB_SYNC_MAX_DROP_PERCENT=50    # il sync completo si ferma se il catalogo cala oltre questa percentuale
# WTB_IMAGE_HOSTS=b2b.wtbsnkrs.it # host da cui il proxy immagini può scaricare (separati da virgola)
# WTB_IMAGE_SEND_KEY=0            # 1 = allega la chiave al download delle immagini (M0: non serve)
# WTB_STOCK_SYNC_INTERVAL=900     # secondi tra due sync dello stock
# WTB_PRODUCTS_SYNC_INTERVAL=10800
# WTB_ORDERS_POLL_INTERVAL=3600   # rilettura degli ordini al fornitore non conclusi
# WTB_REFERENCE_PREFIX=SCSW       # reference degli ordini al fornitore: <prefisso>-<id>-<tentativo>
#
# Non più usate (D-021): WTB_ORDERS_ENABLED, WTB_ORDER_TRIGGER, WTB_PAYMENT_METHOD,
# WTB_MAX_ORDER_EUR, WTB_SHIP_TO_EMAIL, WTB_SHIP_TO_PHONE, WTB_CATALOG_ALL.
# Ora sono in Admin › Impostazioni; se il .env le ha ancora, all'avvio il loro
# valore viene copiato lì una volta sola (bin/migrate.php) e poi si possono togliere.
