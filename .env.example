# ---------------------------------------------------------------------------
# SCS B2B · WTB — variabili d'ambiente
# Copia questo file in .env e adattalo. Il file .env non va MAI committato.
# I valori qui sotto sono sicuri per lo sviluppo (WTB_MODE=fixture, niente rete).
# ---------------------------------------------------------------------------

# --- Applicazione -----------------------------------------------------------
# development | production | test
APP_ENV=development
# 1 = dettagli degli errori a video (solo con APP_ENV=development)
APP_DEBUG=1
# Indirizzo pubblico della piattaforma, senza barra finale (link nelle email)
APP_URL=http://127.0.0.1:8080
# Fuso orario per date e orari mostrati (nel database tutto è in UTC)
APP_TIMEZONE=Europe/Rome
# Livello dei log in var/log/ (debug | info | warning | error)
LOG_LEVEL=info

# --- Database (SQLite, D-010) ----------------------------------------------
# Percorso del file, relativo alla radice del progetto o assoluto
DB_PATH=var/db.sqlite

# --- Sessioni e sicurezza ---------------------------------------------------
# Durata della sessione in secondi (8 ore)
SESSION_LIFETIME=28800
# Cookie solo su HTTPS: auto (secondo la richiesta) | 1 | 0. In produzione è sempre 1.
SESSION_SECURE=auto
# Proxy fidati (CIDR separati da virgola) da cui accettare X-Forwarded-For/Proto.
# In produzione: la subnet della network docker "caddy" e quella interna dello stack.
TRUSTED_PROXIES=
# Hash Argon2id della password admin: php bin/hash-password.php 'la-password'
ADMIN_PASSWORD_HASH=

# --- Email ------------------------------------------------------------------
# log = file .eml in var/mail/ (sviluppo) | smtp = invio vero (AWS SES in produzione)
MAIL_TRANSPORT=log
MAIL_FROM=no-reply@example.com
MAIL_FROM_NAME="SCS B2B"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# tls | ssl | (vuoto = nessuna cifratura)
SMTP_ENCRYPTION=tls

# --- Coordinate per i bonifici dei clienti (D-003) --------------------------
BANK_HOLDER="SHOES & CLOTHING RESELLING OFFICIAL STORE"
BANK_NAME=
BANK_IBAN=
BANK_BIC=

# --- Pro-forma (D-015) -----------------------------------------------------
# Numerazione <prefisso>-<anno>-<NNNN>
RECEIPT_PREFIX=PFW

# --- Fornitore: modalità e chiavi (D-008, docs/03) -------------------------
# fixture = file in fixtures/wtb/, nessuna rete
# test    = API vera con la chiave di prova, ordini simulati dal fornitore
# live    = ordini veri con soldi veri: SOLO sul server di produzione
WTB_MODE=fixture
WTB_BASE_URL=https://b2b.wtbsnkrs.it/api/v1
# Chiave di prova wtb_test_… In Claude Code web lasciala vuota: la aggiunge il proxy.
WTB_API_KEY_TEST=
# Chiave reale: SOLO nel .env del server di produzione, al momento del live
WTB_API_KEY_LIVE=
# Segreto dei webhook (whsec_…) dal portale del fornitore. Vuoto = nessun webhook valido.
# In sviluppo basta un valore inventato qualsiasi per provare "Simula evento" e bin/wtb-webhook.php.
WTB_WEBHOOK_SECRET=
# Timeout delle chiamate in secondi
WTB_HTTP_TIMEOUT=20
# 1 = aggiunge all=1 (ignora "Solo la mia selezione" del portale)
WTB_CATALOG_ALL=0
# Il sync completo si ferma se il feed dei prodotti cala oltre questa percentuale
WTB_SYNC_MAX_DROP_PERCENT=50
# Host da cui il proxy immagini può scaricare (separati da virgola)
WTB_IMAGE_HOSTS=b2b.wtbsnkrs.it
# 1 = allega la chiave al download delle immagini (M0: non serve)
WTB_IMAGE_SEND_KEY=0

# --- Fornitore: intervalli dei job (secondi) --------------------------------
WTB_STOCK_SYNC_INTERVAL=900
WTB_PRODUCTS_SYNC_INTERVAL=10800
WTB_ORDERS_POLL_INTERVAL=3600

# --- Fornitore: ordini (docs/06) -------------------------------------------
# Kill switch: 0 = nessun ordine parte verso il fornitore, nemmeno a mano
WTB_ORDERS_ENABLED=1
# on_confirm (alla conferma del bonifico, D-009) | on_request | manual
WTB_ORDER_TRIGGER=on_confirm
# bank_transfer (D-004) | balance
WTB_PAYMENT_METHOD=bank_transfer
# Prefisso del reference inviato al fornitore: <prefisso>-<id ordine>-<tentativo>
WTB_REFERENCE_PREFIX=SCSW
# Email nel ship_to: admin (la nostra) | customer (quella del cliente)
WTB_SHIP_TO_EMAIL=admin
# Tetto sul costo stimato di un ordine al fornitore in euro (0 = nessun tetto)
WTB_MAX_ORDER_EUR=0

# --- Backup -----------------------------------------------------------------
# Giorni di backup giornalieri da conservare in var/backups/
BACKUP_KEEP_DAYS=14
